{
  "name": "pizza-magnate-web",
  "version": "1.0.0",
  "private": true,
  "description": "Web remake of the 2004 J2ME economic strategy game \"Pizza Magnate\" (Магнат Пиццы), built with TypeScript and Phaser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MicroKoder/sandbox.git"
  },
  "license": "MIT",
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
